# DeepSeek / OpenAI-compatible LLM eval config
# Copy this file to .env and fill in your own key. Do not commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: control eval cost and report size
LLM_EVAL_CASE_LIMIT=3
LLM_EVAL_RUNS=1
# Optional: set this when you want reproducible random sampling
LLM_EVAL_RANDOM_SEED=
LLM_EVAL_TOP_K=5
LLM_EVAL_MAX_OUTPUT_TOKENS=700

# Optional: control tool-loop eval budget
LLM_EVAL_MAX_GREP_ROUNDS=3
LLM_EVAL_QUERIES_PER_ROUND=2
LLM_EVAL_RG_MAX_COUNT=20
